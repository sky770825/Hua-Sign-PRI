# Supabase 配置
# 複製此文件為 .env.local 並填入實際值
# 部署到 Vercel 時，請在 Project Settings > Environment Variables 中設定

# Supabase URL（從 Supabase Dashboard > Settings > API 取得）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key（從 Supabase Dashboard > Settings > API 取得）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key（機密！僅伺服器端，勿暴露於前端）
# 從 Supabase Dashboard > Settings > API > service_role 取得
# ⚠️ 必須是 JWT 格式（eyJ...），不能用 sbp_xxx 的 CLI token！
SUPABASE_SERVICE_KEY=your_service_role_jwt_here

# 管理員密碼（選填，未設定時預設為 h123）
ADMIN_PASSWORD=your_admin_password

# Zoom 會議室（選填，簽到頁顯示加入會議按鈕）
# NEXT_PUBLIC_ZOOM_MEETING_URL=https://us06web.zoom.us/j/86358537640
# NEXT_PUBLIC_ZOOM_MEETING_ID=863 5853 7640
